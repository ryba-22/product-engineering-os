  "modules": [
    {
      "id": "product-strategy",
      "stages": [
        1
      ],
      "mission": "Turn raw ideas and business goals into explicit outcomes, constraints, non-goals and strategic hypotheses."
    },
    {
      "id": "product-discovery",
      "stages": [
        2
      ],
      "mission": "Reduce product risk through user evidence, problem validation, research synthesis and opportunity framing."
    },
    {
      "id": "domain",
      "stages": [
        3,
        5
      ],
      "mission": "Discover domain language, events, rules, boundaries and tactical models from traceable evidence."
    },
    {
      "id": "requirements",
      "stages": [
        4
      ],
      "mission": "Translate validated outcomes and domain evidence into traceable requirements, scenarios, NFRs and acceptance criteria."
    },
    {
      "id": "system-architecture",
      "stages": [
        6
      ],
      "mission": "Choose system structure from quality attributes, forces, failure modes and constraints rather than fashion."
    },
    {
      "id": "experience",
      "stages": [
        7,
        8,
        9,
        10,
        11
      ],
      "mission": "Own UX architecture, interaction, accessibility, visual UI and design-system governance."
    },
    {
      "id": "software-engineering",
      "stages": [
        12,
        13,
        14
      ],
      "mission": "Turn architecture and interaction contracts into maintainable frontend, backend/API and persistence implementations."
    },
    {
      "id": "quality-engineering",
      "stages": [
        15,
        17
      ],
      "mission": "Design risk-based verification and performance evidence at the lowest trustworthy layer."
    },
    {
      "id": "security-reliability",
      "stages": [
        16,
        20,
        21
      ],
      "mission": "Integrate secure SDLC, threat modeling, reliability, observability, DR and incident readiness."
    },
    {
      "id": "delivery-production",
      "stages": [
        18,
        19
      ],
      "mission": "Create reproducible delivery, release evidence, safe rollout and rollback/forward-fix operations."
    },
    {
      "id": "product-intelligence",
      "stages": [
        22,
        23,
        24
      ],
      "mission": "Measure outcomes, run appropriate experiments and turn production feedback into the next evidence-backed iteration."
    },
    {
      "id": "knowledge-governance",
      "stages": [
        25
      ],
      "mission": "Keep sources, evidence, decisions, patterns and evals fresh, attributable, conflict-aware and supersedable."
    }
  ],
