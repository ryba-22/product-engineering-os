{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/product-engineering-os/decision-record.schema.json",
  "type": "object",
  "required": [
    "id",
    "type",
    "status",
    "title",
    "problem",
    "context",
    "evidence",
    "constraints",
    "options",
    "decision",
    "tradeoffs",
    "validation",
    "owner",
    "revisit_trigger"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(PDR|ADR|UDR|SDR|DDR|ODR|TDR)-[0-9]{3,}$"
    },
    "type": {
      "enum": [
        "PDR",
        "ADR",
        "UDR",
        "SDR",
        "DDR",
        "ODR",
        "TDR"
      ]
    },
    "status": {
      "enum": [
        "proposed",
        "accepted",
        "experimental",
        "superseded",
        "deprecated",
        "rejected"
      ]
    },
    "title": {
      "type": "string"
    },
    "problem": {
      "type": "string"
    },
    "context": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "pros",
          "cons"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "pros": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "switch_when": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "decision": {
      "type": "string"
    },
    "tradeoffs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "owner": {
      "type": "string"
    },
    "revisit_trigger": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "related_records": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "date": {
      "type": "string",
      "format": "date"
    }
  },
  "additionalProperties": false
}
