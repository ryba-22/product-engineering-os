{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/product-engineering-os/delivery-assurance/project-policy.schema.json",
  "title": "Project-owned expected delivery policy (not a release payload)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "required_ci_checks",
    "required_artifacts",
    "max_age_minutes"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "project": {
      "type": "string",
      "minLength": 3
    },
    "required_ci_checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "max_age_minutes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ci_gate",
        "approval",
        "runtime_health",
        "recovery"
      ],
      "properties": {
        "ci_gate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 525600
        },
        "approval": {
          "type": "integer",
          "minimum": 1,
          "maximum": 525600
        },
        "runtime_health": {
          "type": "integer",
          "minimum": 1,
          "maximum": 525600
        },
        "recovery": {
          "type": "integer",
          "minimum": 1,
          "maximum": 525600
        }
      }
    }
  }
}
